{
  "name": "react-redux-realworld-example-app",
  "version": "0.1.0",
  "private": true,
  "devDependencies": {
    "cross-env": "^5.1.4",
    "env-cmd": "^8.0.2",
    "react-scripts": "1.1.1"
  },
  "dependencies": {
    "history": "^4.6.3",
    "marked": "^0.3.6",
    "prop-types": "^15.5.10",
    "react": "^16.3.0",
    "react-dom": "^16.3.0",
    "react-redux": "^5.0.7",
    "react-router": "^4.1.2",
    "react-router-dom": "^4.1.2",
    "react-router-redux": "^5.0.0-alpha.6",
    "redux": "^3.6.0",
    "redux-devtools-extension": "^2.13.2",
    "redux-logger": "^3.0.1",
    "superagent": "^3.8.2",
    "superagent-promise": "^1.1.0"
  },
  "scripts": {
    "start": "npm run start:localhost",
    "start:localhost": "env-cmd .env.localhost cross-env PORT=4000 react-scripts start",
    "start:dev": "env-cmd .env.dev cross-env PORT=4100 react-scripts start",
    "start:qa": "env-cmd .env.qa cross-env PORT=4100 react-scripts start",
    "start:prod": "env-cmd .env.prod cross-env PORT=4100 react-scripts start",
    "build": "npm run build:prod",
    "build:localhost": "env-cmd .env.localhost react-scripts build",
    "build:dev": "env-cmd .env.dev react-scripts build",
    "build:qa": "env-cmd .env.qa react-scripts build",
    "build:prod": "env-cmd .env.prod react-scripts build",
    "test": "cross-env PORT=4100 react-scripts test --env=jsdom",
    "eject": "react-scripts eject"
  }
}
